{
  "name": "sermon-post-processor",
  "version": "1.0.0",
  "description": "Convert 4K video files to 1080p for Facebook posting",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc && node esbuild.config.mjs && cp index.html dist/index.html",
    "build:renderer": "node esbuild.config.mjs",
    "start": "npm run build && electron . --no-sandbox"
  },
  "dependencies": {
    "axios": "^1.13.4",
    "electron": "^28.0.0",
    "fluent-ffmpeg": "^2.1.2",
    "form-data": "^4.0.5"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^25.2.1",
    "esbuild": "^0.27.3",
    "typescript": "^5.9.3"
  }
}
